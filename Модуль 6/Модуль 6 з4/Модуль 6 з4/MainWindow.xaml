<Window x:Class="Модуль_6_Задание_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Финансы" Height="700" Width="983">
    <Grid Margin="0,10,0,10" HorizontalAlignment="Center" Width="963">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Добавление -->
        <GroupBox Header="Добавление транзакции" Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <ComboBox x:Name="AddTypeComboBox" Width="80" SelectedIndex="0" Margin="0,0,10,0">
                    <ComboBoxItem Content="income" Tag="income" IsSelected="True"/>
                    <ComboBoxItem Content="expense" Tag="expense"/>
                </ComboBox>
                <TextBlock Text="Категория:" VerticalAlignment="Center"/>
                <TextBox x:Name="AddCategoryTextBox" Width="120" Margin="5,0,10,0"/>
                <TextBlock Text="Сумма:" VerticalAlignment="Center"/>
                <TextBox x:Name="AddAmountTextBox" Width="70" Margin="5,0,10,0"/>
                <TextBlock Text="Дата:" VerticalAlignment="Center"/>
                <TextBox x:Name="AddDateTextBox" Width="80" Margin="5,0,10,0"/>
                <TextBlock Text="Комментарий:" VerticalAlignment="Center"/>
                <TextBox x:Name="AddCommentTextBox" Width="150" Margin="5,0,10,0"/>
                <Button Content="Добавить" Width="80" Click="AddButton_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Редактирование / Удаление -->
        <GroupBox Header="Редактирование / Удаление" Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="ID:" VerticalAlignment="Center"/>
                <TextBox x:Name="EditIdTextBox" Width="50" Margin="5,0,10,0"/>

                <ComboBox x:Name="EditTypeComboBox" Width="80" SelectedIndex="0" Margin="0,0,10,0">
                    <ComboBoxItem Content="income" Tag="income" IsSelected="True"/>
                    <ComboBoxItem Content="expense" Tag="expense"/>
                </ComboBox>
                <TextBlock Text="Категория:" VerticalAlignment="Center"/>
                <TextBox x:Name="EditCategoryTextBox" Width="100" Margin="5,0,10,0"/>
                <TextBlock Text="Сумма:" VerticalAlignment="Center"/>
                <TextBox x:Name="EditAmountTextBox" Width="60" Margin="5,0,10,0"/>
                <TextBlock Text="Дата:" VerticalAlignment="Center"/>
                <TextBox x:Name="EditDateTextBox" Width="80" Margin="5,0,10,0"/>
                <TextBlock Text="Комментарий:" VerticalAlignment="Center"/>
                <TextBox x:Name="EditCommentTextBox" Width="100" Margin="5,0,10,0"/>

                <Button Content="Обновить" Width="80" Margin="0,0,5,0" Click="UpdateButton_Click"/>
                <Button Content="Удалить" Width="70" Click="RemoveButton_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Фильтры -->
        <GroupBox Header="Фильтры" Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Тип:" VerticalAlignment="Center"/>
                <ComboBox x:Name="FilterTypeComboBox" Width="80" Margin="5,0,5,0">
                    <ComboBoxItem Content="Все" Tag=""/>
                    <ComboBoxItem Content="income" Tag="income"/>
                    <ComboBoxItem Content="expense" Tag="expense"/>
                </ComboBox>
                <Button Content="Найти" Width="50" Margin="0,0,15,0" Click="FilterByType_Click"/>

                <TextBlock Text="Категория:" VerticalAlignment="Center"/>
                <TextBox x:Name="FilterCategoryTextBox" Width="100" Margin="5,0,5,0"/>
                <Button Content="Найти" Width="50" Margin="0,0,15,0" Click="FilterByCategory_Click"/>

                <TextBlock Text="Дата:" VerticalAlignment="Center"/>
                <TextBox x:Name="FilterDateTextBox" Width="80" Margin="5,0,5,0"/>
                <Button Content="Найти" Width="50" Click="FilterByDate_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Показать все" Width="100" Margin="0,0,10,0" Click="PrintAllButton_Click"/>
            <Button Content="Показать итоги" Width="120" Margin="0,0,10,0" Click="SummaryButton_Click"/>
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Foreground="DarkGreen" FontWeight="Bold"/>
        </StackPanel>

        <!-- Список -->
        <ListBox x:Name="TransactionsListBox" Grid.Row="4"/>
    </Grid>
</Window>