<Window x:Class="Модуль_6_Задание_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задачи" Height="550" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Добавление -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Название:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="NameTextBox" Width="120" Margin="0,0,10,0"/>
            <TextBlock Text="Текст:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="TextTextBox" Width="180" Margin="0,0,10,0"/>
            <Button Content="Добавить" Width="90" Click="AddButton_Click"/>
        </StackPanel>

        <!-- Удаление -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Название для удаления:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="RemoveNameTextBox" Width="150" Margin="0,0,10,0"/>
            <Button Content="Удалить" Width="100" Click="RemoveButton_Click"/>
        </StackPanel>

        <!-- Обновление -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Название:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="UpdateNameTextBox" Width="120" Margin="0,0,10,0"/>
            <TextBlock Text="Новый текст:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="UpdateTextTextBox" Width="150" Margin="0,0,10,0"/>
            <Button Content="Обновить" Width="100" Click="UpdateButton_Click"/>
        </StackPanel>

        <!-- Кнопка обновления списка и статус -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Обновить список" Width="120" Click="PrintAllButton_Click"/>
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="DarkGreen"/>
        </StackPanel>

        <!-- Список -->
        <ListBox x:Name="TasksListBox" Grid.Row="4"/>
    </Grid>
</Window>