<Window x:Class="Модуль_5_Задание_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр изображений" Height="620" Width="900"
        MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <DockPanel>
        <!-- Меню -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть..." InputGestureText="Ctrl+O"
                          Click="OpenItem_Click"/>
                <MenuItem Header="Закрыть" Click="CloseItem_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="ExitItem_Click"/>
            </MenuItem>
        </Menu>

        <!-- Панель инструментов -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="+" Width="32" Height="26"
                        ToolTip="Увеличить (Ctrl + +)"
                        Click="BtnZoomIn_Click"/>
                <Button Content="−" Width="32" Height="26"
                        ToolTip="Уменьшить (Ctrl + −)"
                        Click="BtnZoomOut_Click"/>
                <Button Content="100%" Width="60" Height="26"
                        ToolTip="Сбросить масштаб (Ctrl + 0)"
                        Click="BtnZoomReset_Click"/>
                <Separator/>
                <Button Content="По размеру окна" Height="26"
                        ToolTip="Вписать в окно (Ctrl + F)"
                        Click="BtnFit_Click"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Статусная строка -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="lblInfo" Text="Изображение не загружено"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Холст -->
        <Border x:Name="canvasBorder"
                Background="#282828"
                ClipToBounds="True"
                Focusable="True">
            <Canvas x:Name="drawCanvas" ClipToBounds="True"
                    Background="Transparent"
                    MouseWheel="Canvas_MouseWheel"
                    MouseDown="Canvas_MouseDown"
                    MouseMove="Canvas_MouseMove"
                    MouseUp="Canvas_MouseUp"
                    SizeChanged="Canvas_SizeChanged">
                <Image x:Name="imgDisplay"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Canvas>
        </Border>
    </DockPanel>
</Window>