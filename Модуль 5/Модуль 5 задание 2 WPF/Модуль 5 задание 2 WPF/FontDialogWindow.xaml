<Window x:Class="TextEditorApp.FontDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка шрифта" Height="380" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Шрифт:"/>
        <ComboBox x:Name="cmbFont" Grid.Row="0" Grid.Column="1" Height="26"
                  SelectionChanged="CmbFont_SelectionChanged"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Размер:"/>
        <ComboBox x:Name="cmbSize" Grid.Row="1" Grid.Column="1" Height="26"
                  IsEditable="True" SelectionChanged="CmbSize_SelectionChanged"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Начертание:"/>
        <ComboBox x:Name="cmbStyle" Grid.Row="2" Grid.Column="1" Height="26"
                  SelectionChanged="CmbStyle_SelectionChanged">
            <ComboBoxItem Content="Обычный"/>
            <ComboBoxItem Content="Курсив"/>
            <ComboBoxItem Content="Полужирный"/>
            <ComboBoxItem Content="Полужирный курсив"/>
        </ComboBox>

        <Label Grid.Row="3" Grid.Column="0" Content="Цвет текста:"/>
        <ComboBox x:Name="cmbColor" Grid.Row="3" Grid.Column="1" Height="26"
                  SelectionChanged="CmbColor_SelectionChanged">
            <ComboBoxItem Content="Чёрный"     Tag="Black"/>
            <ComboBoxItem Content="Красный"    Tag="Red"/>
            <ComboBoxItem Content="Синий"      Tag="Blue"/>
            <ComboBoxItem Content="Зелёный"    Tag="Green"/>
            <ComboBoxItem Content="Жёлтый"     Tag="Yellow"/>
            <ComboBoxItem Content="Оранжевый"  Tag="Orange"/>
            <ComboBoxItem Content="Фиолетовый" Tag="Purple"/>
            <ComboBoxItem Content="Серый"      Tag="Gray"/>
        </ComboBox>

        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                Margin="0,15,0,15" Padding="10"
                BorderBrush="#CCCCCC" BorderThickness="1" Height="60">
            <TextBlock x:Name="txtPreview" Text="Пример текста AaBbCc 123"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="90" Height="30" Margin="0,0,10,0"
                    IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="Отмена" Width="90" Height="30"
                    IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>