<Window x:Class="TextEditorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Текстовый редактор" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Верхняя панель с кнопками -->
        <Border DockPanel.Dock="Top" Height="50" Padding="10"
                Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnOpen" Content="Открыть файл"
                        Width="120" Height="30" Margin="0,0,10,0"
                        Click="BtnOpen_Click"/>
                <Button x:Name="btnSave" Content="Сохранить файл"
                        Width="120" Height="30" Margin="0,0,10,0"
                        Click="BtnSave_Click"/>
                <Button x:Name="btnFont" Content="Настройка шрифта"
                        Width="140" Height="30"
                        Click="BtnFont_Click"/>
            </StackPanel>
        </Border>

        <!-- Поле для текста -->
        <RichTextBox x:Name="richTextBox"
                     FontFamily="Segoe UI" FontSize="14"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     AcceptsReturn="True"/>
    </DockPanel>
</Window>