<Window x:Class="Модуль_5_задание_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список задач" Height="460" Width="520"
        MinHeight="360" MinWidth="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Строка ввода -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="Задача:"
                   VerticalAlignment="Center"/>
            <TextBox x:Name="txtInput" Grid.Column="1"
                     Margin="5,0,10,0" Height="26"
                     VerticalContentAlignment="Center"
                     KeyDown="TxtInput_KeyDown"/>
            <Button x:Name="btnAdd" Grid.Column="2"
                    Content="Добавить" Width="100" Height="26"
                    Click="BtnAdd_Click"/>
        </Grid>

        <!-- Список задач -->
        <ListBox x:Name="lstTasks" Grid.Row="1"
                 FontFamily="Segoe UI" FontSize="14"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="LstTasks_MouseDoubleClick"
                 KeyDown="LstTasks_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Black"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter Property="Foreground" Value="Gray"/>
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="btnDelete" Content="Удалить выбранную"
                    Width="160" Height="32" Margin="0,0,10,0"
                    Click="BtnDelete_Click"/>
            <Button x:Name="btnToggle" Content="Отметить выполненной"
                    Width="180" Height="32" Margin="0,0,10,0"
                    Click="BtnToggle_Click"/>
            <Button x:Name="btnClearDone" Content="Очистить выполненные"
                    Width="140" Height="32"
                    Click="BtnClearDone_Click"/>
        </StackPanel>

        <!-- Статус -->
        <TextBlock x:Name="lblStatus" Grid.Row="3"
                   Margin="0,10,0,0"
                   Foreground="Gray"/>
    </Grid>
</Window>