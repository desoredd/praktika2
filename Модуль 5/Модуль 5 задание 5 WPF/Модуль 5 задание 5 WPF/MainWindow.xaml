<Window x:Class="_8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" Height="500" Width="380"
        MinHeight="450" MinWidth="340"
        WindowStartupLocation="CenterScreen"
        Background="#E8F0FE">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Поле вывода -->
        <TextBox x:Name="textBox1" Grid.Row="0"
                 Height="80" Margin="0,0,0,10"
                 FontSize="26"
                 TextAlignment="Right"
                 VerticalContentAlignment="Center"
                 IsReadOnly="True"
                 Background="White"
                 BorderBrush="#B0C4DE"
                 BorderThickness="1"
                 Padding="8"/>

        <!-- Кнопки -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ряд 1 -->
            <Button Grid.Row="0" Grid.Column="0" Content="%"   Tag="%"    Margin="3" FontSize="18" Click="BtnOp_Click"/>
            <Button Grid.Row="0" Grid.Column="1" Content="C"   Tag="C"    Margin="3" FontSize="18" Click="BtnCl_Click"/>
            <Button Grid.Row="0" Grid.Column="2" Content="DEL" Tag="DEL"  Margin="3" FontSize="18" Click="BtnDel_Click"/>
            <Button Grid.Row="0" Grid.Column="3" Content="+/-" Tag="+/-"  Margin="3" FontSize="18" Click="BtnReverse_Click"/>

            <!-- Ряд 2 -->
            <Button Grid.Row="1" Grid.Column="0" Content="1/X" Tag="1/X"  Margin="3" FontSize="18" Click="BtnDrob_Click"/>
            <Button Grid.Row="1" Grid.Column="1" Content="X^2" Tag="X^2"  Margin="3" FontSize="18" Click="BtnPow_Click"/>
            <Button Grid.Row="1" Grid.Column="2" Content="√X"  Tag="√X"   Margin="3" FontSize="18" Click="BtnSqrt_Click"/>
            <Button Grid.Row="1" Grid.Column="3" Content="/"   Tag="/"    Margin="3" FontSize="18" Click="BtnOp_Click"/>

            <!-- Ряд 3 -->
            <Button Grid.Row="2" Grid.Column="0" Content="7" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
            <Button Grid.Row="2" Grid.Column="1" Content="8" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
            <Button Grid.Row="2" Grid.Column="2" Content="9" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
            <Button Grid.Row="2" Grid.Column="3" Content="X" Tag="*" Margin="3" FontSize="18" Click="BtnOp_Click"/>

            <!-- Ряд 4 -->
            <Button Grid.Row="3" Grid.Column="0" Content="4" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
            <Button Grid.Row="3" Grid.Column="1" Content="5" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
            <Button Grid.Row="3" Grid.Column="2" Content="6" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
            <Button Grid.Row="3" Grid.Column="3" Content="-" Tag="-" Margin="3" FontSize="18" Click="BtnOp_Click"/>

            <!-- Ряд 5 -->
            <Button Grid.Row="4" Grid.Column="0" Content="1" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
            <Button Grid.Row="4" Grid.Column="1" Content="2" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
            <Button Grid.Row="4" Grid.Column="2" Content="3" Margin="3" FontSize="20" Click="BtnDigit_Click"/>
            <Button Grid.Row="4" Grid.Column="3" Content="+" Tag="+" Margin="3" FontSize="18" Click="BtnOp_Click"/>

            <!-- Ряд 6 -->
            <Button Grid.Row="5" Grid.Column="0" Content="0" Grid.ColumnSpan="2"
                    Margin="3" FontSize="20" Click="BtnDigit_Click"/>
            <Button Grid.Row="5" Grid.Column="2" Content="," Tag="," Margin="3" FontSize="20" Click="BtnZap_Click"/>
            <Button Grid.Row="5" Grid.Column="3" Content="=" Margin="3" FontSize="18" Click="BtnRavno_Click"/>
        </Grid>
    </Grid>
</Window>