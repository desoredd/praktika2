<Window x:Class="MyTC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyTC"
        xmlns:conv="clr-namespace:MyTC.Converters"
        Title="Автоматизированная система контроля знаний «MyTC»"
        Width="1020" Height="770"
        MinWidth="800" MinHeight="770" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:StringToImageConverter x:Key="StringToImage"/>
        <conv:StringToBrushConverter x:Key="StringToBrush"/>
    </Window.Resources>

    <TabControl Margin="5">
        <!-- ===== Авторизация ===== -->
        <TabItem Header="Регистрация / Авторизация">
            <Grid>
                <!-- Верхняя панель с кнопкой выхода -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15">
                    <Button Content="Завершить сессию (Выход)" Width="200" Height="30" 
                            Background="Tomato" Foreground="White"
                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"
                            Click="LogoutButton_Click"/>
                </StackPanel>

                <!-- Центральный блок авторизации -->
                <Border BorderBrush="Gray" BorderThickness="1" Background="WhiteSmoke"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="500" Padding="20">
                    <StackPanel Margin="20">
                        <TextBlock Text="Регистрация пользователя в системе «MyTC»"
                                   FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock Text="Выберите роль доступа:" FontWeight="Bold"/>
                        <ComboBox SelectedIndex="{Binding RegRoleIndex}" Margin="0,4,0,12" Height="25">
                            <ComboBoxItem Content="Учащийся (Прохождение тестов)"/>
                            <ComboBoxItem Content="Преподаватель (Конструирование и аудит)"/>
                        </ComboBox>

                        <TextBlock Text="ФИО (для учащегося обязательно):"/>
                        <TextBox Text="{Binding RegName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Height="25"/>

                        <TextBlock Text="Шифр учебной группы:"/>
                        <TextBox Text="{Binding RegGroup, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,12" Height="25"/>

                        <StackPanel Visibility="{Binding IsTeacherRegistration, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Пароль преподавателя:"/>
                            <PasswordBox x:Name="PwdBox" Margin="0,4,0,12" Height="25"/>
                        </StackPanel>

                        <Button Content="Зафиксировать регистрацию"
                                Height="45" Background="LightSkyBlue" FontWeight="Bold" Margin="0,10,0,0"
                                Click="RegisterButton_Click"/>

                        <Border Background="{Binding StatusColor, Converter={StaticResource StringToBrush}}"
                                BorderBrush="Gray" BorderThickness="1" Margin="0,20,0,0" Padding="10">
                            <TextBlock Text="{Binding StatusBanner}" TextAlignment="Center" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- ===== Конструктор ===== -->
        <TabItem Header="Конструктор тестов" IsEnabled="{Binding IsTeacher}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="400"/>
                    <!-- Левая панель -->
                    <ColumnDefinition Width="1.2*"/>
                    <!-- Правая панель -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Grid.ColumnSpan="2" Header="Метаданные теста" Margin="5">
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Название дисциплины:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBox Text="{Binding TestTitle}" Margin="10,0,0,0" VerticalContentAlignment="Center" Height="25" MinWidth="300"/>
                    </StackPanel>
                </GroupBox>

                <!-- Левая панель: Вопрос -->
                <GroupBox Grid.Row="1" Grid.Column="0" Header="Параметры текущего вопроса" Margin="5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="Формулировка вопроса:" FontWeight="Bold"/>
                            <TextBox Text="{Binding QuestionText}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Сложность (1-10):" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding QuestionWeight}" Width="50" Margin="8,0,20,0" TextAlignment="Center" Height="25" VerticalContentAlignment="Center"/>
                                <TextBlock Text="Вариантов (2-5):" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding AnswersCount}" Width="50" Margin="8,0,0,0" TextAlignment="Center" Height="25" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding AnswerOptions}" Margin="0,5,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <RadioButton IsChecked="{Binding IsCorrect}" GroupName="CorrectAnswer" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Height="25" VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Иллюстрация:" FontWeight="Bold" Margin="0,5,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="Gray" BorderThickness="1" Height="120" Margin="0,0,10,0">
                                    <Image Source="{Binding LoadedImagePath, Converter={StaticResource StringToImage}}" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <Button Content="Обзор..." Width="100" Height="28" Click="LoadImageButton_Click"/>
                                    <Button Content="Удалить" Width="100" Height="28" Margin="0,5,0,0" Click="ClearImageButton_Click"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
                                <Button Content="Добавить / Обновить" Width="180" Height="35" Background="LightBlue" FontWeight="Bold" Click="AddOrUpdateQuestionButton_Click"/>
                                <Button Content="Очистить поля" Width="180" Height="35" Margin="15,0,0,0" Click="ClearFieldsButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <!-- Правая панель: Список -->
                <GroupBox Grid.Row="1" Grid.Column="1" Header="Состав теста" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox ItemsSource="{Binding TestQuestions}" SelectedItem="{Binding SelectedQuestion}" DisplayMemberPath="QuestionText" Margin="5"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                            <Button Content="Удалить выбранный" Width="200" Height="35" Click="RemoveQuestionButton_Click"/>
                            <Button Content="Очистить тест" Width="200" Height="35" Margin="10,0,0,0" Click="ClearTestButton_Click"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Нижняя панель: Экспорт/Импорт -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                    <Button Content="Экспортировать (*.mtc)" Width="220" Height="40" FontWeight="Bold" Click="SaveTestButton_Click"/>
                    <Button Content="Импортировать (*.mtc)" Width="220" Height="40" FontWeight="Bold" Margin="15,0,0,0" Click="LoadTestButton_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ===== Тестирование ===== -->
        <TabItem Header="Прохождение тестирования">
            <Grid>
                <!-- Панель перед тестом -->
                <Border Visibility="{Binding IsTesting, Converter={StaticResource InvBoolToVis}}" Padding="30">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Контроль знаний готов к запуску" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="{Binding PreTestInstructions}" FontSize="16" TextWrapping="Wrap" MaxWidth="800" TextAlignment="Center" Margin="0,0,0,30"/>
                        <Button Content="Приступить к тестированию" Width="350" Height="50" Background="LightGreen" FontSize="16" FontWeight="Bold" Click="StartTestingButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Панель выполнения теста -->
                <Border Visibility="{Binding IsTesting, Converter={StaticResource BoolToVis}}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding TestProgress}" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Grid.Row="1" Text="{Binding CurrentQuestionText}" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <!-- Контент вопроса разделен на картинку и ответы -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" MinWidth="300"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <Border BorderBrush="LightGray" BorderThickness="1" Margin="0,0,15,0">
                                <Image Source="{Binding CurrentQuestionImagePath, Converter={StaticResource StringToImage}}" Stretch="Uniform"/>
                            </Border>

                            <ListBox Grid.Column="1" ItemsSource="{Binding TestingAnswers}" SelectedItem="{Binding SelectedAnswer}" FontSize="16" Padding="5" BorderBrush="LightGray">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="5"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>

                        <Button Grid.Row="3" Content="Подтвердить и перейти далее" HorizontalAlignment="Right" Width="300" Height="45" Background="Khaki" FontSize="16" FontWeight="Bold" Margin="0,20,0,0" Click="NextQuestionButton_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <!-- ===== Журнал ===== -->
        <TabItem Header="Журнал результатов">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding VisibleResults}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" Background="White" RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding StudentName}" Width="*"/>
                        <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="*"/>
                        <DataGridTextColumn Header="Балл" Binding="{Binding Score}" Width="Auto"/>
                        <DataGridTextColumn Header="Макс." Binding="{Binding MaxScore}" Width="Auto"/>
                        <DataGridTextColumn Header="Процент" Binding="{Binding Percentage, StringFormat={}{0}%}" Width="Auto"/>
                        <DataGridTextColumn Header="Оценка (РБ)" Binding="{Binding Mark}" Width="Auto"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding DateTimeStamp, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" Background="OldLace" BorderBrush="Gray" BorderThickness="1" Margin="0,10,0,0" Padding="15"
                        Visibility="{Binding CanSeeStatistics, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding GlobalStatistics}" FontSize="14" LineHeight="22"/>
                </Border>

                <Button Grid.Row="2" Content="Очистить журнал" Width="250" Height="35" HorizontalAlignment="Left" Margin="0,10,0,0" FontWeight="Bold"
                        Visibility="{Binding CanClearLogs, Converter={StaticResource BoolToVis}}"
                        Click="ClearLogsButton_Click"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>