<Window x:Class="ProjectManagerWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProjectManagerWpf"
        Title="Управление проектами"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">

    <TabControl Margin="8">

        <!-- ==================== СОТРУДНИКИ ==================== -->
        <TabItem Header="Сотрудники">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <DataGrid Grid.Column="0"
                          ItemsSource="{Binding Employees}"
                          SelectedItem="{Binding SelectedEmployee}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="*"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="ФИО:"/>
                    <TextBox Text="{Binding EmployeeFullName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Должность:" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding EmployeePosition, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Email:" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding EmployeeEmail, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Content="Добавить" Command="{Binding AddEmployeeCommand}" Margin="0,16,0,4"/>
                    <Button Content="Обновить" Command="{Binding UpdateEmployeeCommand}" Margin="0,0,0,4"/>
                    <Button Content="Удалить" Command="{Binding DeleteEmployeeCommand}" Margin="0,0,0,4"/>
                    <Button Content="Отчёт по сотруднику" Command="{Binding ReportEmployeeCommand}" Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ==================== ПРОЕКТЫ ==================== -->
        <TabItem Header="Проекты">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <DataGrid Grid.Column="0"
                          ItemsSource="{Binding Projects}"
                          SelectedItem="{Binding SelectedProject}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Старт"
                                            Binding="{Binding StartDate, StringFormat=yyyy-MM-dd}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Окончание"
                                            Binding="{Binding EndDate, StringFormat=yyyy-MM-dd, TargetNullValue=—}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Название:"/>
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Описание:" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding ProjectDescription, UpdateSourceTrigger=PropertyChanged}" Height="50"/>

                    <TextBlock Text="Дата старта:" Margin="0,8,0,0"/>
                    <DatePicker SelectedDate="{Binding ProjectStartDate}"/>

                    <TextBlock Text="Дата окончания:" Margin="0,8,0,0"/>
                    <DatePicker SelectedDate="{Binding ProjectEndDate}"/>

                    <Button Content="Добавить" Command="{Binding AddProjectCommand}" Margin="0,16,0,4"/>
                    <Button Content="Обновить" Command="{Binding UpdateProjectCommand}" Margin="0,0,0,4"/>
                    <Button Content="Удалить" Command="{Binding DeleteProjectCommand}" Margin="0,0,0,4"/>
                    <Button Content="Отчёт по проекту" Command="{Binding ReportProjectCommand}" Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ==================== ЗАДАЧИ ==================== -->
        <TabItem Header="Задачи">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <DataGrid Grid.Column="0"
                          ItemsSource="{Binding Tasks}"
                          SelectedItem="{Binding SelectedTask}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Проект" Binding="{Binding ProjectName}" Width="*"/>
                        <DataGridTextColumn Header="Сотрудник"
                                            Binding="{Binding EmployeeName, TargetNullValue=—}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Задача" Binding="{Binding Title}" Width="2*"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                        <DataGridTextColumn Header="%" Binding="{Binding Progress}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Название задачи:"/>
                    <TextBox Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Описание:" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding TaskDescription, UpdateSourceTrigger=PropertyChanged}" Height="50"/>

                    <TextBlock Text="Прогресс (0–100):" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding TaskProgress, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Статус:" Margin="0,8,0,0"/>
                    <ComboBox SelectedValue="{Binding TaskStatus, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="Новая"      Tag="{x:Static local:TaskStatus.New}"/>
                        <ComboBoxItem Content="В работе"   Tag="{x:Static local:TaskStatus.InProgress}"/>
                        <ComboBoxItem Content="Выполнена"  Tag="{x:Static local:TaskStatus.Done}"/>
                        <ComboBoxItem Content="Отменена"   Tag="{x:Static local:TaskStatus.Cancelled}"/>
                    </ComboBox>

                    <Button Content="Добавить" Command="{Binding AddTaskCommand}" Margin="0,16,0,4"/>
                    <Button Content="Обновить" Command="{Binding UpdateTaskCommand}" Margin="0,0,0,4"/>
                    <Button Content="Удалить" Command="{Binding DeleteTaskCommand}" Margin="0,0,0,4"/>
                    <Button Content="Назначить сотруднику"
                            Command="{Binding AssignTaskCommand}"
                            Margin="0,16,0,4"/>
                    <Button Content="Обновить прогресс"
                            Command="{Binding UpdateProgressCommand}"
                            Margin="0,0,0,4"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ==================== ОТЧЁТЫ ==================== -->
        <TabItem Header="Отчёты">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="По выбранному проекту"
                            Command="{Binding ReportProjectCommand}"
                            Margin="0,0,8,8"/>
                    <Button Content="По всем проектам"
                            Command="{Binding ReportAllProjectsCommand}"
                            Margin="0,0,8,8"/>
                    <Button Content="По выбранному сотруднику"
                            Command="{Binding ReportEmployeeCommand}"
                            Margin="0,0,8,8"/>
                </StackPanel>

                <TextBox Grid.Row="1"
                         Text="{Binding ReportText, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"/>
            </Grid>
        </TabItem>

    </TabControl>
</Window>