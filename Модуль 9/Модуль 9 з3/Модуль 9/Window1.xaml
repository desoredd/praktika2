<Window x:Class="Модуль_9.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование задачи" Height="240" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Текст:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtText" Grid.Row="0" Grid.Column="1"
                 Height="26" VerticalContentAlignment="Center"
                 Margin="0,4,0,4"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Приоритет:" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmbPriority" Grid.Row="1" Grid.Column="1"
                  Height="26" Margin="0,4,0,4">
            <ComboBoxItem Content="Низкий"/>
            <ComboBoxItem Content="Средний"/>
            <ComboBoxItem Content="Высокий"/>
        </ComboBox>

        <Label Grid.Row="2" Grid.Column="0" Content="Срок:" VerticalAlignment="Center"/>
        <DatePicker x:Name="dpDue" Grid.Row="2" Grid.Column="1"
                    Height="26" Margin="0,4,0,4"/>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="OK" Width="90" Height="28" Margin="0,0,10,0"
                    IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="Отмена" Width="90" Height="28"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>