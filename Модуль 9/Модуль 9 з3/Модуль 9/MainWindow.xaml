<Window x:Class="Модуль_9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список задач" Height="620" Width="830"
        MinHeight="520" MinWidth="830"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Строка ввода -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="Задача:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtInput" Grid.Column="1"
                     Margin="5,0,10,0" Height="26"
                     VerticalContentAlignment="Center"
                     KeyDown="TxtInput_KeyDown"/>

            <Label Grid.Column="2" Content="Приоритет:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="cmbPriority" Grid.Column="3" Width="110" Height="26"
                      SelectedIndex="1" Margin="0,0,10,0">
                <ComboBoxItem Content="Низкий"/>
                <ComboBoxItem Content="Средний"/>
                <ComboBoxItem Content="Высокий"/>
            </ComboBox>

            <Label Grid.Column="4" Content="Срок:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <DatePicker x:Name="dpDue" Grid.Column="5" Height="26" Margin="0,0,92,0"/>

            <Button x:Name="btnAdd" Grid.Column="5"
                    Content="Добавить" Height="26"
                    Click="BtnAdd_Click" Margin="112,0,30,0"/>
        </Grid>

        <!-- Прогресс -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Прогресс:" VerticalAlignment="Center"/>
            <ProgressBar x:Name="prgProgress" Grid.Column="1"
                         Height="18" Margin="5,0,10,0"
                         Minimum="0" Maximum="1"/>
            <TextBlock x:Name="lblProgressPercent" Grid.Column="2"
                       VerticalAlignment="Center" Width="50"
                       TextAlignment="Right"/>
        </Grid>

        <!-- Список задач -->
        <ListBox x:Name="lstTasks" Grid.Row="2"
                 FontFamily="Segoe UI" FontSize="14"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="LstTasks_MouseDoubleClick"
                 KeyDown="LstTasks_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding StatusIcon}"
                                   Width="20" FontSize="16"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding DisplayText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Done}" Value="True">
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding DueDateText}"
                                       FontSize="11" Foreground="Gray"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding PriorityText}"
                                   VerticalAlignment="Center" Margin="10,0"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{Binding PriorityBrush}"/>

                        <Ellipse Grid.Column="3" Width="10" Height="10"
                                 VerticalAlignment="Center"
                                 Fill="{Binding PriorityBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Кнопки управления -->
        <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="btnEdit" Content="Редактировать"
                    Width="130" Height="32" Margin="0,0,10,0"
                    Click="BtnEdit_Click"/>
            <Button x:Name="btnDelete" Content="Удалить выбранную"
                    Width="160" Height="32" Margin="0,0,10,0"
                    Click="BtnDelete_Click"/>
            <Button x:Name="btnToggle" Content="Отметить выполненной"
                    Width="180" Height="32" Margin="0,0,10,0"
                    Click="BtnToggle_Click"/>
            <Button x:Name="btnClearDone" Content="Очистить выполненные"
                    Width="140" Height="32" Margin="0,0,10,0"
                    Click="BtnClearDone_Click"/>
            <Button x:Name="btnNotify" Content="Проверить сроки"
                    Width="140" Height="32"
                    Click="BtnNotify_Click"/>
        </WrapPanel>

        <!-- Статус -->
        <TextBlock x:Name="lblStatus" Grid.Row="4"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="Gray"/>
    </Grid>
</Window>